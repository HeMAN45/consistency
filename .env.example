# Postgres. Use the POOLED connection string for the app (host contains
# "-pooler"), and add connect_timeout so a sleeping serverless database fails
# fast and retries rather than hanging.
DATABASE_URL="postgresql://user:password@host-pooler.example.neon.tech/db?sslmode=require&pgbouncer=true&connect_timeout=15"

# Direct, unpooled connection. Migrations need this: PgBouncer cannot run them.
DIRECT_URL="postgresql://user:password@host.example.neon.tech/db?sslmode=require"

# Auth.js — generate with: npx auth secret
AUTH_SECRET="replace-me"

# Public base URL. Vercel sets VERCEL_URL automatically in production.
AUTH_URL="http://localhost:3000"

# Email (Resend). Without these, password reset and reminders refuse to run
# rather than silently doing nothing.
RESEND_API_KEY=""
EMAIL_FROM="consistency <onboarding@resend.dev>"

# Shared secret for the hourly reminder cron. Generate any long random string.
CRON_SECRET=""

# YouTube Data API v3 key, for playlist import and the analyzer.
# Google Cloud Console, enable "YouTube Data API v3", Credentials, API key.
YOUTUBE_API_KEY=""

# Default timezone applied to new accounts
DEFAULT_TIMEZONE="Asia/Kolkata"
